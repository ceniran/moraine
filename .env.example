# Bind locally unless you add authentication and a trusted reverse proxy.
MORAINE_HOST=127.0.0.1
MORAINE_PORT=4781
MORAINE_API_TOKEN=replace-with-a-long-random-token

MORAINE_MODEL=BAAI/bge-small-zh-v1.5
MORAINE_MODEL_CACHE=./models
MORAINE_INDEX_DIR=./data
MORAINE_THREADS=2
MORAINE_BATCH_SIZE=4
MORAINE_REFRESH_SECONDS=300

# Easiest source: a JSON array, or an object containing an items, documents, or
# memories array. See examples/memories.example.json.
MORAINE_SOURCE_MODE=json
MORAINE_JSON_PATH=./examples/documents.example.json

# Optional HTTP source instead of JSON. The list response may be an array or
# {"memories": [...]}. If list items do not contain full content, configure a
# detail URL with {id}. Keep source credentials outside Git.
# MORAINE_SOURCE_MODE=http
# MORAINE_HTTP_LIST_URL=http://127.0.0.1:4703/api/items?state=active&limit=1000
# MORAINE_HTTP_DETAIL_URL=http://127.0.0.1:4703/api/items/{id}
# MORAINE_HTTP_TOKEN=replace-with-source-token
